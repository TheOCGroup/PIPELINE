# OCG ONE Production Environment Config Example
NODE_ENV=production
PORT=8080
DB_PATH=/srv/ocg/ocg-one/data/ocg_one.db

# Secrets
SESSION_SECRET=YOUR_SECURE_OCG_ONE_SESSION_SECRET
WEBHOOK_SECRET=YOUR_SECURE_WEBHOOK_SECRET
ENCRYPTION_KEY=YOUR_SECURE_ENCRYPTION_KEY

# Standalone PIPELINE Integration Config
PIPELINE_BASE_URL=https://pipeline.ocg-one.com
PIPELINE_INTEGRATION_ENABLED=true

# PIPELINE Handoff Identity (For issuing user handoff tokens)
PIPELINE_HANDOFF_ISSUER=ocg-one
PIPELINE_HANDOFF_AUDIENCE=pipeline
PIPELINE_HANDOFF_PRIVATE_KEY_B64=BASE64_ENCODED_RS256_PRIVATE_KEY
PIPELINE_HANDOFF_KEY_ID=handoff-key-id-1

# PIPELINE S2S Service Identity (For verifying S2S tokens from PIPELINE)
PIPELINE_SERVICE_ISSUER=pipeline
PIPELINE_SERVICE_AUDIENCE=ocg-one-pipeline-integration
PIPELINE_SERVICE_PUBLIC_KEYS_JSON={"service-key-id-1": "---BEGIN PUBLIC KEY---\n..."}

# Feature Flag Transition Sequence (Initial Safe State)
PIPELINE_STANDALONE_ENABLED=false
PIPELINE_EMBEDDED_WRITES_ENABLED=true
PIPELINE_CONVERSION_ENABLED=false
