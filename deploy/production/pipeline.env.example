# Standalone PIPELINE Production Environment Config Example
PIPELINE_ENV=production
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=8090
PIPELINE_DB_PATH=/data/pipeline.db
PIPELINE_ALLOW_OCG_ONE_INTEGRATION=true
PIPELINE_READ_ONLY=true

# Secrets (Generate cryptographically secure strings >= 16 chars)
PIPELINE_SESSION_SECRET=YOUR_SECURE_PIPELINE_SESSION_SECRET
WEBHOOK_SECRET=YOUR_SECURE_WEBHOOK_SECRET
ENCRYPTION_KEY=YOUR_SECURE_ENCRYPTION_KEY

# PIPER secured intake and approved-source discovery
PIPELINE_ENABLE_PIPER_INTAKE=false
PIPELINE_PIPER_INTAKE_SECRET=YOUR_SECURE_PIPER_INTAKE_SECRET
PIPELINE_ENABLE_PIPER_DISCOVERY=false
PIPELINE_PIPER_DISCOVERY_INTERVAL_MINUTES=60
PIPELINE_PIPER_DISCOVERY_USER_AGENT=OCG-PIPER/1.0 (+https://ocgict.com)
PIPELINE_PIPER_DISCOVERY_SOURCES_JSON=[]

# OCG ONE Integration Config
OCG_ONE_BASE_URL=https://os.ocg-one.com
OCG_ONE_HANDOFF_ISSUER=ocg-one
OCG_ONE_HANDOFF_AUDIENCE=pipeline
# JSON mapping of kid -> OCG ONE User Handoff Public Key (SPKI PEM)
OCG_ONE_HANDOFF_PUBLIC_KEYS_JSON={"key-id-1": "---BEGIN PUBLIC KEY---\n..."}


# OCG ONE public keys used to verify inbound S2S conversion/read tokens.
OCG_ONE_SERVICE_PUBLIC_KEYS_JSON={"key-id-1": "---BEGIN PUBLIC KEY---\n..."}
# PIPELINE S2S Service Identity (For outbound calls to OCG ONE)
OCG_ONE_SERVICE_ISSUER=pipeline
OCG_ONE_SERVICE_AUDIENCE=ocg-one-pipeline-integration
OCG_ONE_SERVICE_PRIVATE_KEY_B64=BASE64_ENCODED_RS256_PRIVATE_KEY
OCG_ONE_SERVICE_KEY_ID=service-key-id-1
