# OCG PIPELINE environment (example — placeholders only, no real secrets).
# Copy to .env and fill in for local development. .env is gitignored.

PIPELINE_HOST=127.0.0.1
PIPELINE_PORT=8090
PIPELINE_DB_PATH=./runtime/pipeline.db
PIPELINE_ENV=development

# Secrets — leave blank here. Required only when integration is enabled.
# In production with integration enabled, these must be >= 16 chars or the app
# fails closed on startup.
PIPELINE_SESSION_SECRET=
PIPELINE_HANDOFF_SECRET=

# Machine-to-machine intake boundary (Deal Findr / PIPER). This is the only
# write path in the application, so it is disabled unless explicitly enabled.
# When enabled, callers must send: Authorization: Bearer <the secret below>.
# In production an enabled intake refuses to boot on a secret under 16 chars.
# Read-only mode blocks intake even for an authorized caller.
PIPELINE_ENABLE_PIPER_INTAKE=false
PIPELINE_PIPER_INTAKE_SECRET=

# OCG ONE integration. Disabled by default. When false, PIPELINE never contacts
# OCG ONE and the /auth/handoff endpoint is refused.
OCG_ONE_BASE_URL=http://127.0.0.1:8080
PIPELINE_ALLOW_OCG_ONE_INTEGRATION=false
# Conversion stays disabled in production until an operator completes the
# migration and controlled cutover. Development defaults to writable.
PIPELINE_READ_ONLY=false
